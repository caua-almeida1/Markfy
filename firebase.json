{
  "database": {
    "rules": "database.rules.json",
    "predeploy": [
      "node scripts/build-db-rules.js"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions-backend",
      "codebase": "backend",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "__tests__"
      ],
      "predeploy": [
        "node scripts/sync-menus-engine.js"
      ]
    }
  ]
}
