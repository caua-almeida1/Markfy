        ".write": false
      }
    },
    "menusOps": {
      "_comentario": [
        "Operacao: estado das mesas, comandas, pedidos, chamados, sequencias e chaves de idempotencia.",
        "Membros leem (tempo real entre aparelhos). NINGUEM grava pelo navegador:",
        "toda mudanca passa pela Cloud Function menusApi, com transacao e auditoria."
      ],
      "$handle": {
        ".read": "auth != null && root.child('companys').child($handle).child('members').child(auth.uid).exists()",
        ".write": false,
        "orders": {
          ".indexOn": [
            "createdAt",
            "status",
            "dayKey"
          ]
        },
        "tabs": {
          ".indexOn": [
            "status",
            "openedAt",
            "closedAt"
          ]
        },
        "calls": {
          ".indexOn": [
            "status"
          ]
        }
      }
    },
    "menusTrack": {
      "_comentario": "Acompanhamento publico do pedido, sem dados pessoais. Le-se so pelo id (impossivel listar). Grava o backend.",
      "$handle": {
        "$orderId": {
          ".read": true,
          ".write": false
        }
      }
    },
    "menusLedger": {
      "_comentario": "Livro de recebimentos e estornos (caixa). Leitura: dono, administrador, gerente e caixa. Grava o backend.",
      "$handle": {
        ".read": "(auth != null && (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'master' || root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'administrator' || (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'professional' && root.child('menusStaff').child($handle).child(auth.uid).child('role').val() === 'manager'))) || (auth != null && root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'professional' && root.child('menusStaff').child($handle).child(auth.uid).child('role').val() === 'cashier')",
        ".write": false,
        ".indexOn": [
          "at",
          "dayKey"
        ]
      }
    },
    "menusAudit": {
      "_comentario": [
        "Registro de auditoria. O backend grava descontos, cancelamentos, estornos, reaberturas e transferencias.",
        "O painel so ACRESCENTA registros de alteracao de preco e de permissao (nunca altera nem apaga)."
      ],
      "$handle": {
        ".read": "auth != null && (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'master' || root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'administrator' || (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'professional' && root.child('menusStaff').child($handle).child(auth.uid).child('role').val() === 'manager'))",
        ".indexOn": [
          "at"
        ],
        "$entryId": {
          ".write": "auth != null && (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'master' || root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'administrator' || (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'professional' && root.child('menusStaff').child($handle).child(auth.uid).child('role').val() === 'manager')) && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['type', 'at', 'by']) && newData.child('by').val() === auth.uid && newData.child('type').isString() && newData.child('type').val().matches(/^(catalog|team)[.]/)"
        }
      }
    },
    "menusStock": {
      "_comentario": "Estoque por produto. Membros leem; so o backend movimenta (baixa por pedido, entrada, perda, contagem).",
      "$handle": {
        ".read": "auth != null && root.child('companys').child($handle).child('members').child(auth.uid).exists()",
        ".write": false
      }
    },
    "menusStockMoves": {
      "$handle": {
        ".read": "auth != null && root.child('companys').child($handle).child('members').child(auth.uid).exists()",
        ".write": false,
        ".indexOn": [
          "at",
          "productId"
        ]
      }
    },
    "menusStaff": {
      "_comentario": "Perfil de cada profissional no Menus (gerente, garcom, caixa, cozinha, entregador) e ajustes de permissao. Grava: dono ou administrador.",
      "$handle": {
        ".read": "auth != null && root.child('companys').child($handle).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'master' || root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'administrator')",
          ".validate": "!newData.exists() || (newData.child('role').isString() && newData.child('role').val().matches(/^(manager|waiter|cashier|kitchen|delivery)$/))"
        }
      }
    },
    "menusRate": {
      "_comentario": "Contadores do freio de pedidos publicos (backend).",
      ".read": false,
      ".write": false
    },
    "bookingRate": {
      "_comentario": "Freio por IP da bookingsApi (so backend).",
      ".read": false,
      ".write": false
    },
    "bookingLocks": {
      "_comentario": "Trava por profissional/dia da bookingsApi (so backend).",
      ".read": false,
      ".write": false
    }
  }
}
