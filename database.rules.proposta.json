      "$handle": {
        ".read": "auth != null && root.child('companys').child($handle).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'master' || root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'administrator' || (root.child('companys').child($handle).child('members').child(auth.uid).child('role').val() === 'professional' && root.child('menusStaff').child($handle).child(auth.uid).child('role').val() === 'manager'))"
      }
    },
    "menusSites": {
      "_comentario": "Aparencia PUBLICADA. So o backend (menusApi/design.publish) grava, depois de aplicar o plano.",
      "$handle": {
        ".read": "(root.child('licenses').child($handle).child('status').val() === 'active' && root.child('licenses').child($handle).child('product').isString() && root.child('licenses').child($handle).child('product').val().matches(/^(menus|all)$/) && (root.child('licenses').child($handle).child('expiresAt').val() === null || root.child('licenses').child($handle).child('expiresAt').val() > now)) || auth != null && root.child('companys').child($handle).child('members').child(auth.uid).exists()",
        ".write": false
      }
    },
    "menusSlugs": {
      "_comentario": "Endereco publico /m/{slug} -> handle. Leitura publica de uma chave por vez; so o backend grava.",
